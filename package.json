{
  "name": "ai-commit-msg",
  "displayName": "DiffCommit AI — Multi-Provider Commit Messages",
  "description": "Generate commit messages from git diff using AI — Claude, OpenAI, Gemini, DeepSeek, Grok, Mistral, Groq, OpenRouter, Ollama",
  "version": "0.0.1",
  "publisher": "vaibhava17",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "keywords": [
    "commit",
    "git",
    "ai",
    "claude",
    "openai",
    "gemini",
    "ollama",
    "conventional commits"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaibhava17/vscode-ext.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "AI"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiCommit.generate",
        "title": "AI Commit: Generate Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiCommit.setup",
        "title": "AI Commit: Select Provider, Model & API Key"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiCommit.generate",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AI Commit Message",
      "properties": {
        "aiCommit.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "gemini",
            "deepseek",
            "xai",
            "mistral",
            "groq",
            "openrouter",
            "ollama",
            "custom"
          ],
          "enumDescriptions": [
            "Anthropic Claude",
            "OpenAI GPT",
            "Google Gemini",
            "DeepSeek",
            "xAI Grok",
            "Mistral",
            "Groq",
            "OpenRouter",
            "Ollama (local, no API key)",
            "Custom OpenAI-compatible endpoint"
          ],
          "description": "AI provider used to generate commit messages"
        },
        "aiCommit.model": {
          "type": "string",
          "default": "claude-opus-4-8",
          "description": "Model ID (e.g. claude-opus-4-8, gpt-4o, gemini-2.0-flash, deepseek-chat, llama3.2)"
        },
        "aiCommit.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Override base URL. For Ollama defaults to http://localhost:11434. Required for provider 'custom'."
        },
        "aiCommit.includeBody": {
          "type": "boolean",
          "default": true,
          "description": "Allow a multi-line body (bullet points) below the subject when the diff has several changes. Off = subject line only."
        },
        "aiCommit.maxDiffChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Diff is truncated to this many characters before sending to the model."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
